---
import '@fontsource-variable/cascadia-code/wght.css';
interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full font-bellota" data-palette="superior">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Alejandro Hernández — frontend, UX/UI and fullstack developer. Explore my interactive terminal portfolio." />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="icon" href="/adechlien-logo.svg" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css"/>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Bellota+Text:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet"/>
    </head>

    <body class="min-h-screen bg-adech-swamp-3 text-adech-boulevard-1 antialiased overflow-x-hidden">
        <slot />
    </body>
</html>
