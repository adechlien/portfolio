---
import { projects } from "../../data/portfolio.js";
import ProjectIcon from '../ProjectIcon.astro';
---

<section class="hidden w-full flex-col gap-3 overflow-visible pb-1" data-tab-panel="projects">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    {projects.map((project) => (
      <a href={project.href} target="_blank" rel="noreferrer" class="grid grid-cols-[48px_minmax(0,1fr)] items-center gap-3 rounded-lg bg-adech-swamp-2 p-2 transition hover:brightness-110">
        <ProjectIcon project={project} />
        <div class="flex min-w-0 flex-col gap-2 text-left text-adech-boulevard-2">
          <div class="min-w-0">
            <h4 class="truncate text-lg font-semibold leading-tight">{project.name}</h4>
            <p class="text-sm leading-snug text-adech-boulevard-4">{project.desc}</p>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {project.tech.map(({ label, className }) => (
              <span class={`rounded-full border border-current px-2.5 py-0.5 text-xs font-semibold leading-tight ${className}`}>
                {label}
              </span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
