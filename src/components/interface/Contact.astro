---
import { contact } from "../../data/portfolio.js";
---

<section class="hidden w-full flex-col gap-3 overflow-visible pb-1" data-tab-panel="contact">
  <form data-contact-form class="h-full" action={contact.action} method="POST">
    <div class="flex flex-col gap-3 sm:gap-4">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-2">
        <label class="flex flex-col gap-1">
          <span class="text-sm text-adech-boulevard-2">{contact.fields.name.label}</span>
          <input name="name" type="text" required class="rounded-md bg-adech-swamp-2 px-2 py-2 outline-none placeholder:text-adech-boulevard-4 sm:py-1" placeholder={contact.fields.name.placeholder}/>
        </label>

        <label class="flex flex-col gap-1">
          <span class="text-sm text-adech-boulevard-2">{contact.fields.email.label}</span>
          <input name="email" type="email" required class="rounded-md bg-adech-swamp-2 px-2 py-2 outline-none placeholder:text-adech-boulevard-4 sm:py-1" placeholder={contact.fields.email.placeholder}/>
        </label>
      </div>

      <label class="flex flex-col gap-1">
        <span class="text-sm text-adech-boulevard-2">{contact.fields.message.label}</span>
        <textarea name="message" rows="4" required class="resize-none rounded-md bg-adech-swamp-2 px-2 py-2 outline-none placeholder:text-adech-boulevard-4 sm:py-1" placeholder={contact.fields.message.placeholder}></textarea>
      </label>

      <input type="hidden" name="_subject" value={contact.subject} />

      <button type="submit" class="rounded-md bg-adech-boulevard-4 p-2 text-sm font-semibold text-adech-swamp-3 transition hover:opacity-90 disabled:opacity-60">
        {contact.submitLabel}
      </button>

      <p data-contact-status class="hidden text-sm text-adech-boulevard-2" aria-live="polite"></p>
    </div>
  </form>
</section>

<script define:vars={{ contact }}>
  const form = document.querySelector("[data-contact-form]");
  const submitButton = form?.querySelector('button[type="submit"]');
  const status = form?.querySelector("[data-contact-status]");

  if (form instanceof HTMLFormElement &&
      submitButton instanceof HTMLButtonElement &&
      status instanceof HTMLParagraphElement) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitButton.disabled = true;
      submitButton.textContent = contact.sendingLabel;
      status.classList.remove("hidden");
      status.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          form.reset();
          status.textContent = contact.successMessage;
        } else {
          status.textContent = contact.errorMessage;
        }
      } catch {
        status.textContent = contact.connectionErrorMessage;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = contact.submitLabel;
      }
    });
  }
</script>
